{
  "name": "respawn-plus",
  "private": true,
  "version": "0.1.0",
  "description": "Respawn+ — a Linux game launcher and modding environment",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "check": "node --check src/main.js && node --check vite.config.js && node --check scripts/test-game.mjs && node --check scripts/prepare-skyrim-test.mjs",
    "doctor": "bash scripts/doctor.sh",
    "setup:runtime": "bash scripts/install-umu.sh",
    "bundle:check": "node scripts/check-runtime-bundle.mjs",
    "bundle:lite": "tauri build --features custom-protocol",
    "bundle:full": "npm run bundle:check && tauri build --features custom-protocol --config packaging/tauri.full.conf.json",
    "test:packaging": "node --test tests/runtime-bundle.test.mjs",
    "test-game:setup": "node scripts/test-game.mjs install",
    "test-game:play": "node scripts/test-game.mjs play",
    "test-game:status": "node scripts/test-game.mjs status",
    "tauri": "tauri"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.4",
    "vite": "^8.3.5"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@tauri-apps/api": "^2.9.0",
    "@tauri-apps/plugin-dialog": "^2.8.3"
  }
}
