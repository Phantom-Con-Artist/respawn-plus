{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Respawn+",
  "mainBinaryName": "respawn-plus",
  "version": "0.1.0",
  "identifier": "dev.respawnplus.launcher",
  "build": { "beforeDevCommand": "npm run dev", "devUrl": "http://localhost:1420", "beforeBuildCommand": "npm run build", "frontendDist": "../dist" },
  "app": { "windows": [{ "label": "main", "title": "Respawn+", "width": 1280, "height": 900, "minWidth": 720, "minHeight": 560 }], "security": { "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost; img-src 'self' data: https://shared.akamai.steamstatic.com" } },
  "bundle": {
    "active": true,
    "targets": ["deb", "rpm"],
    "category": "Game",
    "shortDescription": "Linux game launcher and modding environment",
    "license": "MIT",
    "licenseFile": "../LICENSE",
    "copyright": "Copyright (C) 2026 Respawn+ contributors",
    "resources": {
      "../LICENSE": "licenses/Respawn+/LICENSE",
      "../NOTICE": "licenses/Respawn+/NOTICE",
      "../THIRD_PARTY_NOTICES.md": "licenses/THIRD_PARTY_NOTICES.md",
      "../test-games/licenses/mines-LICENCE.txt": "licenses/Mines/LICENCE.txt"
    },
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"]
  }
}

