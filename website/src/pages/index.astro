---
// SPDX-License-Identifier: MIT
import Base from '../layouts/Base.astro';
import NightWindow from '../components/NightWindow.astro';

const repo = 'https://github.com/Phantom-Con-Artist/respawn-plus';

// The journey: each station is one part of the product, shown in the real launcher.
const stations = [
  { sign: 'Find', title: 'Every game finds its seat.', text: 'Find games looks through your folders for Windows games, or add any .exe yourself. Nothing is copied or changed on the way.', details: ['Scans ~/Games, Downloads and your Steam libraries, or one folder you pick', 'Never runs what it finds and never changes its files', 'Runs through Proton with UMU, system Wine, Lutris Wine or a runner you choose'], shot: 'library', alt: 'The Vessel library, night theme: twelve games with their artwork, how each one starts, playtime and a Play button. Fallout 4 is running.' },
  { sign: 'Room', title: 'One room for each game.', text: 'Each game gets its own sandbox: a private home, its own Proton or Wine prefix, and checkpoints to roll the room back. Nothing in it touches the rest of your system.', details: ['Private home, /tmp and process, IPC and network namespaces; your own files are not mounted', 'Online or offline, set per game', 'Shared Windows dependencies, such as a Visual C++ runtime, mounted read-only instead of copied', 'A checkpoint before each session; restore the setup and keep your saves'], shot: 'skyrim', alt: 'Skyrim Special Edition’s page in Vessel: its room strip, with Mod Organizer 2 chosen to start the game and a trainer set to open with it.' },
  { sign: 'Board', title: 'The companions ride together.', text: 'A mod manager, a script extender, a trainer: each one runs inside the game’s room and can see the game, just as on Windows. Choose what starts the game and what opens beside it.', details: ['Every app has a kind: mod manager, script extender, trainer or utility', 'Mod managers and script extenders can start the game', 'Trainers and utilities attach to it, or open with it automatically', 'On Wayland, each app gets its own window'], shot: 'fallout', alt: 'Fallout 4 running in Vessel, started through Mod Organizer 2, with its script extender listed beside it and a Stop room button.' },
  { sign: 'Depart', title: 'One press. Never a black screen.', text: 'Play starts exactly the setup you chose and shows each part come up, so a quiet minute while Proton prepares the room never looks like something broke.', details: ['Shows the room, the starter and each companion come up', 'A launch log for every game and every app', 'Playtime and sessions for each game', 'Stop room closes everything in it at once'], shot: 'launch', alt: 'The Vessel launch screen: the room’s blocks fill one by one while Skyrim Special Edition starts.' },
];

// Linux today, against the same moment with Vessel.
const contrasts = [
  ['Every game needs its own Wine prefix, made and kept by hand.', 'Each game gets its own prefix and runner, set up for it.'],
  ['A trainer started on its own cannot see the game’s process.', 'Trainers join the game’s room and find the game, as on Windows.'],
  ['A mod manager runs in another environment and loses track of the game.', 'Mod Organizer 2, Vortex or any manager shares the game’s prefix and can start it.'],
  ['One misbehaving tool can reach your whole home folder.', 'Each room is a sandbox with a private home, and checkpoints roll its setup back.'],
  ['A black window while Proton prepares: did it break?', 'Vessel shows each part of the room come up, then gets out of the way.'],
];

// Everything in the Beta, as a timetable of short lines.
const aboard = [
  ['Finds your games', 'Scans folders for Windows games or imports any .exe.'],
  ['One room per game', 'A bubblewrap sandbox with one Proton or Wine prefix.'],
  ['Any companion app', 'Added by its kind, never by its name.'],
  ['Play through', 'Start the game from a mod manager or script extender.'],
  ['Opens with the game', 'Switch trainers and tools on to start beside it.'],
  ['Online or offline', 'Network access chosen per room.'],
  ['Shared dependencies', 'Windows runtimes imported once, mounted read-only.'],
  ['Room recovery', 'Checkpoints that restore setup and keep saves.'],
  ['Separate windows', 'One per app on Wayland, or one window for the room.'],
  ['Display modes', 'Fullscreen, borderless or windowed in the one-window room.'],
  ['Playtime', 'Every session timed, with two weeks of daily totals.'],
  ['Launch logs', 'A log for every launch, readable in the launcher.'],
  ['Finds your runners', 'UMU, Steam and Flatpak Proton, system and Lutris Wine.'],
  ['Three themes', 'Milky, Night and Ashen, or follow your desktop.'],
  ['Keyboard first', 'Search with /, move with arrows, play with Ctrl+Enter.'],
  ['Local and open', 'A local SQLite library. Rust, Tauri, MIT.'],
];

// Questions asked at the platform.
const questions = [
  ['Do I need Steam?', 'No. Vessel runs a game’s Windows executable directly through Proton (with UMU) or Wine. Games that must be started by Steam itself, for DRM, are not routed through Steam yet.'],
  ['Does it work with online games and anti-cheat?', 'Not claimed. Kernel anti-cheat is not supported. Vessel is built for single-player games and their mods.'],
  ['Which mod managers and trainers work?', 'Any app is added by its kind: mod manager, script extender, trainer or utility. Mod Organizer 2, SKSE and a standalone trainer have been run with Skyrim Special Edition. Vortex, WeMod and others are added the same way but are not tested yet.'],
  ['Will it change my game files?', 'Finding a game copies and changes nothing. Display mode and isolation are applied to the room, never by editing the game’s own settings. Your mod manager changes what it always changes.'],
  ['Which Linux does it run on?', 'Any distribution. It is tested on Fedora with KDE Plasma on Wayland; secure rooms need a Wayland session to show a window.'],
  ['Is it a full sandbox?', 'A room is a bubblewrap sandbox with private namespaces and a seccomp filter, not a virtual machine. The kernel, GPU and audio services are still shared.'],
];

// The four ways a modding player starts a game, as the launcher words them.
const routes = [
  { id: 'vanilla', name: 'Vanilla', stops: ['Skyrim Special Edition'], sentence: 'Play starts Skyrim Special Edition.' },
  { id: 'trainer', name: 'With a trainer', stops: ['Skyrim Special Edition', 'FLiNG Trainer'], sentence: 'Play starts Skyrim Special Edition, then opens FLiNG Trainer.' },
  { id: 'modded', name: 'Modded', stops: ['Mod Organizer 2', 'Skyrim Special Edition'], sentence: 'Play opens Mod Organizer 2, which starts Skyrim Special Edition.' },
  { id: 'modded-trainer', name: 'Modded, with a trainer', stops: ['Mod Organizer 2', 'Skyrim Special Edition', 'FLiNG Trainer'], sentence: 'Play opens Mod Organizer 2, which starts Skyrim Special Edition, then opens FLiNG Trainer.' },
];

// The showcase library, as a departure board. Only the first row has been run end to end.
const departures = [
  { game: 'Skyrim Special Edition', via: 'Mod Organizer 2', with: 'FLiNG Trainer', status: 'Tested' },
  { game: 'Fallout 4', via: 'Mod Organizer 2', with: 'F4SE', status: 'Showcase' },
  { game: 'Baldur’s Gate 3', via: 'BG3 Mod Manager', with: '—', status: 'Showcase' },
  { game: 'The Witcher 3: Wild Hunt', via: 'The game', with: 'Script Merger', status: 'Showcase' },
  { game: 'Cyberpunk 2077', via: 'Vortex', with: 'Trainer', status: 'Showcase' },
  { game: 'Stardew Valley', via: 'SMAPI', with: '—', status: 'Showcase' },
  { game: 'Fallout: New Vegas', via: 'Mod Organizer 2', with: 'NVSE', status: 'Showcase' },
  { game: 'Mount & Blade II: Bannerlord', via: 'Vortex', with: '—', status: 'Showcase' },
];

// What actually ran, on the developer's machine (see docs/companion-apps.md).
const log = [
  ['System', 'Fedora, KDE Plasma on Wayland'],
  ['Runner', 'GE-Proton 11-11 through UMU 1.4.4'],
  ['Game', 'Skyrim Special Edition 1.7.104'],
  ['Mod manager', 'Mod Organizer 2.5.2, its virtual file system loaded'],
  ['Script extender', 'SKSE 2.3.1, started by Mod Organizer 2'],
  ['Trainer', 'A standalone trainer, attached to the running game'],
  ['Windows', 'Each app in its own window on the desktop'],
];
---
<Base title="Vessel · Windows games and their mods, carried home on Linux" description="Vessel runs Windows games on Linux with their mod manager, script extender and trainer in one room. A showcase build, tested with Skyrim Special Edition. Free and open source." current="home">
  <section class="boarding" aria-labelledby="hero-title">
    <div class="boarding-top">
      <h1 id="hero-title" class="arrive">Your games,<br /><span>carried home.</span></h1>
      <p class="next-sign" aria-label="Next stop: Skyrim Special Edition, through Mod Organizer 2"><span>Next</span><b data-flap="SKYRIM SPECIAL EDITION">SKYRIM SPECIAL EDITION</b><span>via Mod Organizer 2</span></p>
    </div>
    <NightWindow label="Outside the window, a night city slides past under a cyan horizon" />
    <div class="boarding-foot">
      <p class="lead">Vessel runs Windows games on Linux with their mod manager, script extender and trainer in one room. Choose how to play once; one press, and they leave together.</p>
      <div class="actions">
        <a class="button primary" href={`${repo}/releases`}>Follow releases</a>
        <a class="button" href="/downloads/">Build from source</a>
      </div>
      <p class="showcase-note">Showcase build · tested so far with Skyrim Special Edition</p>
    </div>
  </section>

  <section class="statement" data-arrive aria-labelledby="what-title">
    <h2 id="what-title" class="sr-only">What Vessel is</h2>
    <svg class="statement-mark" viewBox="89 116 1078 1078" aria-hidden="true"><path class="panel-left" d="M160 186Q160 140 198.1 165.8L569.9 417.6Q603 440 603 480L603 696Q603 742 625.3 782.2L641.7 811.8Q664 852 664 898L664 1130Q664 1170 630.8 1147.7L198.2 857.6Q160 832 160 786Z" /><path class="panel-right" d="M1062.3 197.6Q1096 176 1096 216L1096 836Q1096 882 1057.2 906.7L787.7 1078.5Q754 1100 754 1060L754 852Q754 806 730.2 766.7L680.8 685.3Q657 646 657 600L657 498Q657 458 690.7 436.4Z" /></svg>
    <p class="statement-text arrive">Vessel is a <strong>Linux launcher for Windows games</strong>. It gives each game <strong>its own room</strong>, a sandbox with one Proton prefix, and lets your <strong>mod manager, script extender and trainer</strong> board that same room, so they work together the way they do on Windows.</p>
  </section>

  <section class="contrast" aria-labelledby="why-title">
    <h2 id="why-title" class="arrive">Why it exists.</h2>
    <div class="contrast-table arrive" role="table" aria-label="Linux today compared with Vessel">
      <div class="contrast-row contrast-head" role="row"><span role="columnheader">Outside · Linux today</span><span role="columnheader">Inside · with Vessel</span></div>
      {contrasts.map(([before, after]) => <div class="contrast-row" role="row"><span role="cell">{before}</span><span role="cell">{after}</span></div>)}
    </div>
  </section>

  <section class="journey" aria-label="How Vessel works, station by station">
    {stations.map((s, i) => (
      <article class="station" data-station={i}>
        <div class="station-text arrive">
          <p class="station-sign"><span data-flap={s.sign.toUpperCase()}>{s.sign.toUpperCase()}</span><i>{i + 1} of {stations.length}</i></p>
          <h2>{s.title}</h2>
          <p>{s.text}</p>
          <ul class="spec">{s.details.map((d) => <li>{d}</li>)}</ul>
        </div>
        <figure class="screen arrive">
          <img src={`/shots/showcase-${s.shot}.webp`} width="2000" height="1250" alt={s.alt} loading={i ? 'lazy' : 'eager'} decoding="async" />
          <figcaption>The real launcher, shown with a sample library.</figcaption>
        </figure>
      </article>
    ))}
  </section>

  <section class="section-room" aria-labelledby="inside-title">
    <div class="section-room-head arrive">
      <h2 id="inside-title">Inside a room.</h2>
      <p>A room is one game’s sandbox. Everything you add to the game runs in it, in one Proton container, so the trainer can find the game and the mod manager can start it. What sits outside the walls stays out.</p>
    </div>
    <div class="cutaway arrive" aria-label="Diagram of a room">
      <div class="cut-outside">
        <p class="cut-label">Outside, not mounted</p>
        <ul><li>Your home folder</li><li>Other games’ rooms</li><li>The launcher database</li><li>SSH agent and session D-Bus</li></ul>
      </div>
      <div class="cut-room">
        <p class="cut-label">Room · bubblewrap sandbox</p>
        <p class="cut-note">Private home and /tmp · own PID, IPC and network namespaces · seccomp filter</p>
        <div class="cut-net"><span>Network</span>pasta, online · or none, offline</div>
        <div class="cut-container">
          <p class="cut-label">Proton container · one prefix</p>
          <ol class="cut-apps">
            <li style="--i:0"><i>Mod manager</i>Mod Organizer 2</li>
            <li style="--i:1"><i>Game</i>SkyrimSE.exe with SKSE</li>
            <li style="--i:2"><i>Trainer</i>FLiNG Trainer</li>
            <li style="--i:3"><i>Windows</i>wineserver</li>
          </ol>
          <div class="cut-shared"><span>Read-only</span>Shared Windows dependencies</div>
        </div>
      </div>
    </div>
  </section>

  <section class="routes" aria-labelledby="routes-title">
    <div class="routes-head arrive">
      <h2 id="routes-title">Four ways to ride.</h2>
      <p>Vanilla, with a trainer, modded, or modded with a trainer. Pick a route and Vessel says, in one sentence, exactly what Play will do.</p>
    </div>
    <div class="route-picker" role="radiogroup" aria-label="Route">
      {routes.map((r, i) => <button type="button" role="radio" aria-checked={i === 3 ? 'true' : 'false'} tabindex={i === 3 ? 0 : -1} data-route={r.id}>{r.name}</button>)}
    </div>
    <div class="route-map arrive" aria-live="polite">
      <ol class="route-line" id="route-line">
        <li class="stop origin"><span>Room</span></li>
        {routes[3].stops.map((stop, i) => <li class="stop" style={`--i:${i + 1}`}><span>{stop}</span></li>)}
      </ol>
      <p class="route-sentence" id="route-sentence">{routes[3].sentence}</p>
    </div>
    <script is:inline type="application/json" id="route-data" set:html={JSON.stringify(routes)} />
  </section>

  <section class="departures" aria-labelledby="board-title">
    <div class="board arrive">
      <div class="board-head"><h2 id="board-title">Departures</h2><p class="board-clock" id="board-clock" aria-hidden="true">23:58</p></div>
      <table>
        <thead><tr><th scope="col">Game</th><th scope="col">Starts through</th><th scope="col">Opens with it</th><th scope="col">Status</th></tr></thead>
        <tbody>
          {departures.map((d) => (
            <tr class:list={{ tested: d.status === 'Tested' }}>
              <td><span class="cell" data-flap={d.game.toUpperCase()}>{d.game.toUpperCase()}</span></td>
              <td>{d.via}</td>
              <td>{d.with}</td>
              <td><span class="status">{d.status}</span></td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
    <p class="board-note arrive">A showcase library. Only the first row has run end to end; the rest shows how a library looks, not tested support. Any game, mod manager or trainer is added the same way, by what kind of app it is.</p>
  </section>

  <section class="ran" aria-labelledby="ran-title">
    <div class="ran-head arrive">
      <h2 id="ran-title">What has actually run.</h2>
      <p>Vessel claims only what was run. This is the trip that was taken, on one machine, end to end.</p>
    </div>
    <dl class="ticket arrive">
      {log.map(([k, v]) => <div><dt>{k}</dt><dd>{v}</dd></div>)}
    </dl>
  </section>

  <section class="aboard" aria-labelledby="aboard-title">
    <h2 id="aboard-title" class="arrive">Everything aboard the Beta.</h2>
    <dl class="aboard-list arrive">
      {aboard.map(([k, v]) => <div><dt>{k}</dt><dd>{v}</dd></div>)}
    </dl>
  </section>

  <section class="questions" aria-labelledby="questions-title">
    <h2 id="questions-title" class="arrive">Questions at the platform.</h2>
    <div class="question-list arrive">
      {questions.map(([q, a], i) => <details open={i === 0}><summary>{q}</summary><p>{a}</p></details>)}
    </div>
  </section>

  <section class="last-train" aria-labelledby="last-title">
    <NightWindow size="slim" label="The night city, still passing" />
    <div class="last-copy arrive">
      <h2 id="last-title">Ride along when it leaves.</h2>
      <p>v0.1.0 Beta is on its way. Follow the releases to hear when the first packages for Fedora, Ubuntu and Debian are out, or build it tonight.</p>
      <div class="actions">
        <a class="button primary" href={`${repo}/releases`}>Follow releases</a>
        <a class="button" href="/docs/">Read the docs</a>
      </div>
    </div>
  </section>

  <script>
    // Choose a route: the line redraws its stops and the sentence says what Play will do.
    const routes = JSON.parse(document.getElementById('route-data')?.textContent || '[]');
    const buttons = [...document.querySelectorAll<HTMLButtonElement>('[data-route]')];
    const line = document.getElementById('route-line');
    const sentence = document.getElementById('route-sentence');
    const choose = (button: HTMLButtonElement) => {
      const route = routes.find((r: { id: string }) => r.id === button.dataset.route);
      if (!route || !line || !sentence) return;
      for (const b of buttons) { const on = b === button; b.setAttribute('aria-checked', String(on)); b.tabIndex = on ? 0 : -1; }
      line.replaceChildren(...['Room', ...route.stops].map((name: string, i: number) => {
        const stop = document.createElement('li');
        stop.className = 'stop' + (i ? '' : ' origin');
        stop.style.setProperty('--i', String(i));
        stop.innerHTML = '<span></span>';
        stop.querySelector('span')!.textContent = name;
        return stop;
      }));
      line.classList.remove('drawn'); void line.offsetWidth; line.classList.add('drawn');
      sentence.textContent = route.sentence;
    };
    for (const b of buttons) b.addEventListener('click', () => choose(b));
    document.querySelector('.route-picker')?.addEventListener('keydown', (event) => {
      const e = event as KeyboardEvent;
      const step = ({ ArrowRight: 1, ArrowDown: 1, ArrowLeft: -1, ArrowUp: -1 } as Record<string, number>)[e.key];
      if (!step) return;
      e.preventDefault();
      const next = buttons[(buttons.indexOf(document.activeElement as HTMLButtonElement) + step + buttons.length) % buttons.length];
      next.focus(); choose(next);
    });
    line?.classList.add('drawn');

    // The board keeps the visitor's own time.
    const clock = document.getElementById('board-clock');
    const tickClock = () => { if (clock) clock.textContent = new Date().toLocaleTimeString([], { hour: '2-digit', minute: '2-digit', hour12: false }); };
    tickClock(); setInterval(tickClock, 15000);
  </script>
</Base>
