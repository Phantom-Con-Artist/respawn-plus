---
// SPDX-License-Identifier: MIT
import Base from '../layouts/Base.astro';
import NightWindow from '../components/NightWindow.astro';
const repo = 'https://github.com/Phantom-Con-Artist/respawn-plus';
---
<Base title="Downloads · Vessel" description="Vessel v0.1.0 Beta packages for Fedora, Ubuntu and Debian are coming. Build from source today." current="downloads">
  <header class="page-head">
    <h1 class="arrive">Downloads</h1>
    <p class="arrive">v0.1.0 Beta is on its way. Packages appear here and on GitHub Releases the day it ships; until then, you can build it yourself.</p>
  </header>
  <NightWindow size="slim" />
  <section class="inner" aria-label="Packages">
    <div class="timetable arrive">
      <article>
        <p class="when">Coming with v0.1.0 · RPM and DEB</p>
        <h2>Lite</h2>
        <p>Uses the Proton, Wine and UMU you already have. The smallest download, and the first one out.</p>
        <ul><li>Fedora and openSUSE: RPM</li><li>Ubuntu and Debian: DEB</li></ul>
        <a class="button primary" href={`${repo}/releases`}>Follow releases</a>
      </article>
      <article>
        <p class="when">Planned after v0.1.0</p>
        <h2>Full</h2>
        <p>Bundles a tested Wine and Proton runtime stack with its licences and sources, for machines that have none.</p>
        <ul><li>Same RPM and DEB formats</li><li>Every bundled part listed in the notices</li></ul>
        <a class="link" href="/docs/distribution/">How the editions differ</a>
      </article>
      <article>
        <p class="when">Available now · MIT</p>
        <h2>Source</h2>
        <p>Build and run the current Beta from the repository. You need Rust, Node.js 22 and the Tauri system libraries.</p>
        <ul><li>Tested on Fedora with GE-Proton 11</li><li>Secure rooms need a Wayland session</li></ul>
        <a class="link" href={repo}>Open the repository</a>
      </article>
    </div>
    <div class="source arrive">
      <div><h2>Build it tonight</h2><p>Clone, install and start the launcher in development mode. The Lite packages come from the same commands.</p></div>
      <pre><code>git clone {repo}.git vessel
cd vessel
npm ci
npm run tauri dev            # run the launcher
npm run bundle:lite          # build the Lite RPM and DEB</code></pre>
    </div>
  </section>
</Base>
