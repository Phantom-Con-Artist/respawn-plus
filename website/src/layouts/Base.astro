---
// SPDX-License-Identifier: MIT
import '../styles/site.css';

interface Props { title: string; description: string; current?: 'home' | 'docs' | 'downloads' | 'about' }
const { title, description, current } = Astro.props;
const repo = 'https://github.com/Phantom-Con-Artist/respawn-plus';
---
<!doctype html>
<html lang="en" class="no-js">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content="/shots/showcase-skyrim.webp" />
    <meta name="theme-color" content="#07090f" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Big+Shoulders+Display:wght@500;700;800;900&family=Hanken+Grotesk:wght@400;500;600&display=swap" rel="stylesheet" />
    <script is:inline>document.documentElement.classList.remove('no-js');</script>
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <header class="carriage-head">
      <a class="wordmark" href="/" aria-label="Vessel home"><img src="/wordmark.svg" alt="Vessel" width="138" height="28" /></a>
      <nav aria-label="Main">
        <a href="/docs/" aria-current={current === 'docs' ? 'page' : undefined}>Docs</a>
        <a href="/downloads/" aria-current={current === 'downloads' ? 'page' : undefined}>Downloads</a>
        <a href="/about/" aria-current={current === 'about' ? 'page' : undefined}>About</a>
        <a href={repo}>GitHub</a>
      </nav>
    </header>
    <main id="main"><slot /></main>
    <footer class="terminus">
      <div class="terminus-line" aria-hidden="true"><span></span></div>
      <div class="terminus-grid">
        <div class="terminus-name">
          <img class="terminus-sign" src="/wordmark.svg" alt="Vessel" width="400" height="81" loading="lazy" />
          <p>Windows games on Linux, with their mods, in one room. Free and open source, MIT. v0.1.0 Beta, a showcase build tested with Skyrim Special Edition.</p>
        </div>
        <div><h2>Ride</h2><a href="/downloads/">Downloads</a><a href="/docs/">Documentation</a><a href="/about/">About</a></div>
        <div><h2>Guides</h2><a href="/docs/library/">Your library</a><a href="/docs/companion-apps/">Mods and trainers</a><a href="/docs/test-game/">First test game</a></div>
        <div><h2>Line</h2><a href={repo}>Source code</a><a href={`${repo}/releases`}>Releases</a><a href={`${repo}/issues`}>Issues</a><a href={`${repo}/blob/main/LICENSE`}>MIT licence</a></div>
      </div>
      <p class="terminus-small">Game artwork belongs to its publishers and is shown from Steam as illustration only. © 2026 Vessel contributors.</p>
    </footer>
    <script>
      // Arrivals: a section's parts settle in once as it reaches the window. Without script, all is shown.
      const io = new IntersectionObserver((entries) => {
        for (const entry of entries) if (entry.isIntersecting) { entry.target.classList.add('in'); io.unobserve(entry.target); }
      }, { rootMargin: '0px 0px -10% 0px' });
      document.querySelectorAll('.arrive, [data-arrive]').forEach((el) => io.observe(el));

      // Station signs flap through letters before landing, like a split-flap board.
      const glyphs = 'ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789';
      const flap = (el: HTMLElement) => {
        const target = el.dataset.flap ?? el.textContent ?? '';
        if (matchMedia('(prefers-reduced-motion: reduce)').matches) { el.textContent = target; return; }
        let step = 0;
        const timer = setInterval(() => {
          step++;
          el.textContent = [...target].map((c, i) => (c === ' ' || i < step - 6 ? c : glyphs[(i * 7 + step * 3) % glyphs.length])).join('');
          if (step > target.length + 6) { clearInterval(timer); el.textContent = target; }
        }, 34);
      };
      (window as any).vesselFlap = flap;
      const flaps = new IntersectionObserver((entries) => {
        for (const entry of entries) if (entry.isIntersecting) { flap(entry.target as HTMLElement); flaps.unobserve(entry.target); }
      });
      document.querySelectorAll<HTMLElement>('[data-flap]').forEach((el) => flaps.observe(el));
    </script>
  </body>
</html>
